const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const scoreEl = document.getElementById('score');
const bestScoreEl = document.getElementById('best-score');
const overlay = document.getElementById('overlay');
const startBtn = document.getElementById('startBtn');

const groundY = canvas.height - 70;
const keys = { left: false, right: false };

const state = {
  running: false,
  gameOver: false,
  score: 0,
  best: Number(localStorage.getItem('escooter-best') || 0),
  time: 0,
  speed: 5,
  spawnTimer: 0,
  batteryTimer: 0,
  distance: 0,
};

const player = {
  x: 160,
  y: groundY - 50,
  width: 78,
  height: 48,
  velocityY: 0,
  gravity: 0.62,
  jumpPower: 13,
  moveSpeed: 6.5,
  grounded: true,
};

const obstacles = [];
const batteries = [];

function resetGame() {
  state.running = true;
  state.gameOver = false;
  state.score = 0;
  state.time = 0;
  state.speed = 5;
  state.spawnTimer = 0;
  state.batteryTimer = 0;
  state.distance = 0;

  obstacles.length = 0;
  batteries.length = 0;

  player.x = 160;
  player.y = groundY - 50;
  player.velocityY = 0;
  player.grounded = true;
}

function setOverlayMessage(show) {
  overlay.classList.toggle('visible', show);
}

function showStartScreen() {
  setOverlayMessage(true);
  overlay.innerHTML = `
    <h1>E-Scooter Rush</h1>
    <p>Dodge obstacles, collect batteries, and keep riding.</p>
    <ul>
      <li>Move: A / D or ← / →</li>
      <li>Jump: W, ↑, or Space</li>
    </ul>
    <button id="startBtn">Start Ride</button>
  `;

  const btn = document.getElementById('startBtn');
  btn.addEventListener('click', () => {
    resetGame();
    setOverlayMessage(false);
  });
}

function updateBest() {
  bestScoreEl.textContent = String(state.best);
}

function jump() {
  if (!state.running || player.grounded === false) return;
  player.velocityY = -player.jumpPower;
  player.grounded = false;
}

function spawnObstacle() {
  const typeRoll = Math.random();
  const width = 36 + Math.random() * 62;
  const height = typeRoll < 0.5 ? 30 + Math.random() * 32 : 22 + Math.random() * 28;
  const obstacle = {
    x: canvas.width + 40,
    y: groundY - height,
    width,
    height,
    color: typeRoll < 0.34 ? '#ff7f50' : typeRoll < 0.68 ? '#ffb703' : '#ff5d73',
    type: typeRoll < 0.5 ? 'cone' : 'barrier',
  };
  obstacles.push(obstacle);
}

function spawnBattery() {
  const battery = {
    x: canvas.width + 40,
    y: groundY - 80 - Math.random() * 90,
    radius: 13,
    bob: Math.random() * Math.PI * 2,
  };
  batteries.push(battery);
}

function handleInput() {
  if (keys.left) {
    player.x -= player.moveSpeed;
  }
  if (keys.right) {
    player.x += player.moveSpeed;
  }

  player.x = Math.max(30, Math.min(canvas.width - player.width - 30, player.x));
}

function updateGame() {
  if (!state.running) return;

  state.time += 1;
  state.distance += 1;
  state.score = Math.floor(state.distance / 8);
  state.speed = 5 + state.score * 0.02;

  if (state.score > state.best) {
    state.best = state.score;
    localStorage.setItem('escooter-best', String(state.best));
  }

  scoreEl.textContent = String(state.score);
  updateBest();

  handleInput();

  player.velocityY += player.gravity;
  player.y += player.velocityY;

  if (player.y >= groundY - player.height) {
    player.y = groundY - player.height;
    player.velocityY = 0;
    player.grounded = true;
  }

  const spawnInterval = Math.max(40, 90 - state.score * 0.6);
  state.spawnTimer += 1;
  if (state.spawnTimer > spawnInterval) {
    spawnObstacle();
    state.spawnTimer = 0;
  }

  state.batteryTimer += 1;
  if (state.batteryTimer > 160) {
    spawnBattery();
    state.batteryTimer = 0;
  }

  for (let i = obstacles.length - 1; i >= 0; i--) {
    const ob = obstacles[i];
    ob.x -= state.speed;

    if (ob.x + ob.width < -10) {
      obstacles.splice(i, 1);
      continue;
    }

    const colliding =
      player.x < ob.x + ob.width &&
      player.x + player.width > ob.x &&
      player.y < ob.y + ob.height &&
      player.y + player.height > ob.y;

    if (colliding) {
      state.running = false;
      state.gameOver = true;
      setOverlayMessage(true);
      overlay.innerHTML = `
        <h1>Crash!</h1>
        <p>Final score: <strong>${state.score}</strong></p>
        <p>Press Enter to ride again.</p>
        <button id="restartBtn">Restart</button>
      `;
      const restartBtn = document.getElementById('restartBtn');
      restartBtn.addEventListener('click', () => {
        resetGame();
        setOverlayMessage(false);
      });
      return;
    }
  }

  for (let i = batteries.length - 1; i >= 0; i--) {
    const cell = batteries[i];
    cell.x -= state.speed;
    cell.bob += 0.12;

    const dx = player.x + player.width / 2 - cell.x;
    const dy = player.y + player.height / 2 - (cell.y + Math.sin(cell.bob) * 8);
    const dist = Math.hypot(dx, dy);

    if (dist < 24) {
      state.score += 25;
      batteries.splice(i, 1);
      continue;
    }

    if (cell.x + 15 < -10) {
      batteries.splice(i, 1);
    }
  }
}

function drawBackground() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  ctx.fillStyle = '#8fd9ff';
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  ctx.fillStyle = '#bfe8ff';
  for (let i = 0; i < 7; i++) {
    const x = ((i * 220) - (state.distance * 0.5) % 240) - 60;
    const y = 70 + (i % 2) * 32;
    ctx.beginPath();
    ctx.arc(x, y, 24, 0, Math.PI * 2);
    ctx.arc(x + 26, y - 8, 20, 0, Math.PI * 2);
    ctx.arc(x - 18, y + 8, 18, 0, Math.PI * 2);
    ctx.fill();
  }

  ctx.fillStyle = '#1d2e3b';
  ctx.fillRect(0, groundY, canvas.width, canvas.height - groundY);

  ctx.strokeStyle = '#f5f7ff';
  ctx.lineWidth = 4;
  ctx.setLineDash([28, 28]);
  ctx.beginPath();
  ctx.moveTo(0, groundY + 12);
  ctx.lineTo(canvas.width, groundY + 12);
  ctx.stroke();
  ctx.setLineDash([]);

  ctx.fillStyle = '#6c7c8f';
  for (let x = -40; x < canvas.width + 100; x += 80) {
    const offset = ((state.distance * 2) % 80);
    ctx.fillRect(x - offset, groundY + 34, 44, 18);
  }
}

function drawPlayer() {
  const px = player.x;
  const py = player.y;

  ctx.save();
  ctx.translate(px + player.width / 2, py + player.height / 2);

  ctx.fillStyle = '#1d3557';
  ctx.fillRect(-25, 4, 50, 18);

  ctx.fillStyle = '#2a9d8f';
  ctx.fillRect(-12, -10, 24, 16);

  ctx.fillStyle = '#edf6ff';
  ctx.fillRect(-28, 20, 12, 8);
  ctx.fillRect(16, 20, 12, 8);

  ctx.fillStyle = '#8ecae6';
  ctx.fillRect(-2, -18, 20, 14);

  ctx.fillStyle = '#0f172a';
  ctx.fillRect(-16, 0, 8, 28);
  ctx.fillRect(8, 0, 8, 28);

  ctx.restore();
}

function drawObstacle(ob) {
  ctx.save();
  ctx.translate(ob.x, ob.y);

  if (ob.type === 'cone') {
    ctx.fillStyle = '#ff9f1c';
    ctx.beginPath();
    ctx.moveTo(0, ob.height);
    ctx.lineTo(ob.width / 2, 0);
    ctx.lineTo(ob.width, ob.height);
    ctx.closePath();
    ctx.fill();
    ctx.fillStyle = '#fee9b2';
    ctx.fillRect(ob.width * 0.35, 10, ob.width * 0.3, ob.height * 0.5);
  } else {
    ctx.fillStyle = ob.color;
    ctx.fillRect(0, ob.height * 0.3, ob.width, ob.height * 0.7);
    ctx.fillStyle = '#ffe7a3';
    ctx.fillRect(8, ob.height * 0.48, ob.width - 16, 8);
  }

  ctx.restore();
}

function drawBattery(cell) {
  ctx.save();
  const bobOffset = Math.sin(cell.bob) * 8;
  ctx.translate(cell.x, cell.y + bobOffset);

  ctx.fillStyle = '#ffe66d';
  ctx.fillRect(-10, -12, 20, 24);
  ctx.fillStyle = '#2a9d8f';
  ctx.fillRect(-6, -8, 12, 16);
  ctx.fillStyle = '#fffbeb';
  ctx.fillRect(-2, -10, 4, 20);
  ctx.restore();
}

function draw() {
  drawBackground();

  for (const cell of batteries) {
    drawBattery(cell);
  }

  for (const ob of obstacles) {
    drawObstacle(ob);
  }

  drawPlayer();
}

function gameLoop() {
  updateGame();
  draw();
  requestAnimationFrame(gameLoop);
}

window.addEventListener('keydown', (event) => {
  const key = event.key.toLowerCase();
  if (key === 'a' || key === 'arrowleft') keys.left = true;
  if (key === 'd' || key === 'arrowright') keys.right = true;
  if (key === ' ' || key === 'arrowup' || key === 'w') {
    event.preventDefault();
    if (!state.running && !state.gameOver) {
      resetGame();
      setOverlayMessage(false);
    }
    jump();
  }
  if (key === 'enter' && state.gameOver) {
    resetGame();
    setOverlayMessage(false);
  }
});

window.addEventListener('keyup', (event) => {
  const key = event.key.toLowerCase();
  if (key === 'a' || key === 'arrowleft') keys.left = false;
  if (key === 'd' || key === 'arrowright') keys.right = false;
});

showStartScreen();
updateBest();
requestAnimationFrame(gameLoop);
startBtn.addEventListener('click', () => {
  resetGame();
  setOverlayMessage(false);
});

window.addEventListener('blur', () => {
  keys.left = false;
  keys.right = false;
});
